# Base de départ — ne pas committer
rpi-imager-main/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Build artefacts
build/
dist/
*.egg

# IDE
.vscode/
.idea/

# POC artifacts (binary fixtures rebuildable on demand via tests/poc/*.sh)
tests/poc/*.img
tests/poc/*.ext4
/tmp/

# UI tour screenshots — regenerated on demand via scripts/ui_tour.py
screenshots/
tour/

# E2E test fixtures (rebuildable via tests/fixtures/make_pi_os_fixture.py)
tests/fixtures/*.img
tests/fixtures/*.ext4
tests/fixtures/*.fat32

# Vendored binaries (must be populated locally — see vendor/README.md)
vendor/*.exe
vendor/*.dll

# Native C ABI build artifacts (astro_flash.dll built via native/build.ps1)
native/build_obj/

# Compressed fixtures (rebuildable: gzip a tests/fixtures/*.img)
tests/fixtures/*.img.gz

# Session / agent artifacts
.claude/
tmp_pytest/

# Local-only dev artifacts (kept on disk, never tracked)
CLAUDE.md
docs/superpowers/
